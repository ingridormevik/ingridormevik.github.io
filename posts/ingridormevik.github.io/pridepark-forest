<!-- CDN IMMERSIVE RESEARCH BACKGROUND -->
<canvas id="cdn-network"></canvas>

<script>
(function(){

const canvas = document.getElementById("cdn-network");
if(!canvas) return;

const ctx = canvas.getContext("2d");
let nodes = [];

function resize(){
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize",resize);

for(let i=0;i<26;i++){
  nodes.push({
    x:Math.random()*canvas.width,
    y:Math.random()*canvas.height,
    vx:(Math.random()-0.5)*0.25,
    vy:(Math.random()-0.5)*0.25
  });
}

function draw(){

  ctx.clearRect(0,0,canvas.width,canvas.height);

  ctx.strokeStyle="rgba(0,200,255,0.12)";
  ctx.lineWidth=1;

  for(let i=0;i<nodes.length;i++){
    let a=nodes[i];

    a.x+=a.vx;
    a.y+=a.vy;

    if(a.x<0||a.x>canvas.width)a.vx*=-1;
    if(a.y<0||a.y>canvas.height)a.vy*=-1;

    for(let j=i+1;j<nodes.length;j++){
      let b=nodes[j];

      let dx=a.x-b.x;
      let dy=a.y-b.y;
      let d=Math.sqrt(dx*dx+dy*dy);

      if(d<160){
        ctx.globalAlpha=1-(d/160);
        ctx.beginPath();
        ctx.moveTo(a.x,a.y);
        ctx.lineTo(b.x,b.y);
        ctx.stroke();
      }
    }

    ctx.globalAlpha=1;
    ctx.beginPath();
    ctx.arc(a.x,a.y,1.4,0,Math.PI*2);
    ctx.fillStyle="rgba(255,255,255,0.6)";
    ctx.fill();
  }

  requestAnimationFrame(draw);
}

draw();

const dust=document.createElement("canvas");
dust.style.position="fixed";
dust.style.inset="0";
dust.style.pointerEvents="none";
dust.style.zIndex="1";
dust.style.opacity="0.25";

document.body.appendChild(dust);

const dctx=dust.getContext("2d");

function resizeDust(){
dust.width=window.innerWidth;
dust.height=window.innerHeight;
}
resizeDust();
window.addEventListener("resize",resizeDust);

let particles=[];

for(let i=0;i<60;i++){
particles.push({
x:Math.random()*dust.width,
y:Math.random()*dust.height,
vy:0.1+Math.random()*0.2
});
}

function drawDust(){

dctx.clearRect(0,0,dust.width,dust.height);

dctx.fillStyle="rgba(255,255,255,0.6)";

particles.forEach(p=>{
p.y-=p.vy;
if(p.y<0)p.y=dust.height;

dctx.beginPath();
dctx.arc(p.x,p.y,1,0,Math.PI*2);
dctx.fill();
});

requestAnimationFrame(drawDust);
}

drawDust();

})();
</script>

