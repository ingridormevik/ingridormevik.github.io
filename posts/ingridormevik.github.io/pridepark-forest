function kittelsenCanvas(creature, w=300, h=200) {
  const id = 'kit-' + creature + '-' + Date.now();
  setTimeout(()=>{
    const canvas = document.getElementById(id); if(!canvas) return;
    const ctx = canvas.getContext('2d');
    const dpr = devicePixelRatio||1;
    canvas.width = w*dpr; canvas.height = h*dpr;
    canvas.style.width=w+'px'; canvas.style.height=h+'px';
    ctx.scale(dpr,dpr);
    drawKittelsenScene(ctx, creature, w, h);
    playCreatureSound(creature);
    haptic([50,30,80,30,50]);
  }, 100);
  return `<canvas id="${id}" class="kit-canvas" style="max-width:100%;height:auto;"></canvas>`;
}

function drawKittelsenScene(ctx, creature, W, H) {
  let t = 0;
  function frame() {
    t += 0.025;
    ctx.clearRect(0,0,W,H);
    // Dark wash bg
    const bg=ctx.createLinearGradient(0,0,0,H);
    bg.addColorStop(0,'rgba(2,4,14,1)'); bg.addColorStop(1,'rgba(0,2,8,1)');
    ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);
    // Grain
    for(let i=0;i<80;i++){
      ctx.fillStyle=`rgba(255,255,255,${Math.random()*0.025})`;
      ctx.fillRect(Math.random()*W,Math.random()*H,1,1);
    }
    switch(creature){
      case 'nokken':    drawNokken(ctx,W,H,t); break;
      case 'huldra':    drawHuldra(ctx,W,H,t); break;
      case 'fossegren': drawFossegren(ctx,W,H,t); break;
      case 'draugen':   drawDraugen(ctx,W,H,t); break;
      case 'bergtroll': drawBergtroll(ctx,W,H,t); break;
    }
  }
  let frames = 0;
  const loop = () => { if(frames++ > 300) return; frame(); requestAnimationFrame(loop); }
  loop();
}

function drawNokken(ctx,W,H,t){
  const wy=H*0.62;
  // Water surface
  for(let i=0;i<4;i++){
    ctx.beginPath(); ctx.moveTo(0,wy+i*8);
    for(let x=0;x<=W;x+=6) ctx.lineTo(x,wy+i*8+Math.sin(x*0.03+t*(0.8+i*0.2))*3);
    ctx.strokeStyle=`rgba(0,160,100,${0.12-i*0.025})`; ctx.lineWidth=1.5; ctx.stroke();
  }
  // Rings
  [0,1,2].forEach(ri=>{
    const r=(18+ri*18)*(1+Math.sin(t*0.8+ri)*0.08);
    const a=0.25-ri*0.07+Math.sin(t+ri)*0.04;
    ctx.beginPath(); ctx.arc(W*0.5,wy,r,0,Math.PI*2);
    ctx.strokeStyle=`rgba(0,200,110,${a})`; ctx.lineWidth=1; ctx.stroke();
  });
  // Eyes
  [-1,1].forEach(side=>{
    const ex=W*0.5+side*22, ey=wy-3+Math.sin(t*0.5)*2;
    const g=ctx.createRadialGradient(ex,ey,0,ex,ey,9);
    g.addColorStop(0,'rgba(0,255,130,0.9)'); g.addColorStop(1,'transparent');
    ctx.fillStyle=g; ctx.fillRect(ex-9,ey-9,18,18);
    ctx.beginPath(); ctx.ellipse(ex,ey,5,3.5,0,0,Math.PI*2);
    ctx.fillStyle='rgba(0,240,120,0.85)'; ctx.fill();
    ctx.beginPath(); ctx.ellipse(ex,ey,2.5,1.8,0,0,Math.PI*2);
    ctx.fillStyle='rgba(0,0,0,0.9)'; ctx.fill();
    ctx.beginPath(); ctx.ellipse(ex-1,ey-1,0.8,0.8,0,0,Math.PI*2);
    ctx.fillStyle='rgba(255,255,255,0.7)'; ctx.fill();
  });
  // Lily pads
  [-55,-28,30,58].forEach((ox,i)=>{
    const lx=W*0.5+ox, ly=wy+4+i*2;
    ctx.beginPath(); ctx.ellipse(lx,ly,10+i*2,5+i,Math.random()*0.1,0,Math.PI*2);
    ctx.fillStyle=`rgba(0,120,60,${0.3+Math.sin(t+i)*0.1})`; ctx.fill();
  });
  // Reflection
  [-1,1].forEach(side=>{
    ctx.beginPath(); ctx.moveTo(W*0.5+side*22,wy);
    ctx.lineTo(W*0.5+side*22,wy+20+Math.sin(t)*3);
    ctx.strokeStyle='rgba(0,200,100,0.15)'; ctx.lineWidth=2; ctx.stroke();
  });
  // Text
  ctx.font='10px Cinzel,serif'; ctx.fillStyle='rgba(255,255,255,0.25)';
  ctx.textAlign='center'; ctx.fillText('NØKKEN — Th. Kittelsen 1887', W/2, H-10);
}

function drawHuldra(ctx,W,H,t){
  const cy=H*0.45;
  // Trees
  [0.1,0.3,0.7,0.9].forEach((fx,i)=>{
    const sw=Math.sin(t*0.4+fx*8)*0.04;
    branchDraw(ctx,fx*W,H*0.92,H*0.28+i*10,2.5,5,sw);
  });
  // Body
  const bx=W*0.5, by=H*0.42;
  ctx.beginPath(); ctx.ellipse(bx,by+30,10,22,0,0,Math.PI*2);
  ctx.fillStyle='rgba(200,150,120,0.7)'; ctx.fill();
  // Head
  ctx.beginPath(); ctx.ellipse(bx,by,12,14,0,0,Math.PI*2);
  ctx.fillStyle='rgba(220,170,130,0.8)'; ctx.fill();
  // Hair (32 strands)
  for(let i=0;i<32;i++){
    const ang=(i/31)*Math.PI+0.1;
    const len=22+Math.sin(t*0.6+i*0.4)*5;
    const ex=bx+Math.cos(ang+Math.PI)*len, ey=by-8+Math.sin(ang)*len-4;
    ctx.beginPath(); ctx.moveTo(bx+Math.cos(ang)*8,by-6);
    const hue=`rgba(${180+i*2},${100+i},${60+i*0.5},${0.5+Math.sin(t+i*0.3)*0.2})`;
    ctx.bezierCurveTo(bx+Math.cos(ang)*20,by+Math.sin(ang)*5,ex,ey,ex+Math.cos(ang+t*0.02)*8,ey-8);
    ctx.strokeStyle=hue; ctx.lineWidth=0.8; ctx.stroke();
  }
  // Tail
  const tailX=bx+8, tailY=by+42;
  ctx.beginPath(); ctx.moveTo(tailX,tailY);
  ctx.bezierCurveTo(tailX+20,tailY+12,tailX+30,tailY+5+Math.sin(t)*6,tailX+40+Math.sin(t*0.7)*5,tailY+18);
  ctx.strokeStyle='rgba(139,90,40,0.7)'; ctx.lineWidth=3; ctx.stroke();
  ctx.beginPath(); ctx.ellipse(tailX+40+Math.sin(t*0.7)*5,tailY+20,6,4,t*0.2,0,Math.PI*2);
  ctx.fillStyle='rgba(100,60,30,0.6)'; ctx.fill();
  // Glow
  const g=ctx.createRadialGradient(bx,by,0,bx,by,45);
  g.addColorStop(0,'rgba(255,150,80,0.08)'); g.addColorStop(1,'transparent');
  ctx.fillStyle=g; ctx.fillRect(bx-45,by-45,90,90);
  ctx.font='10px Cinzel,serif'; ctx.fillStyle='rgba(255,255,255,0.25)';
  ctx.textAlign='center'; ctx.fillText('HULDRA — Th. Kittelsen 1900', W/2, H-10);
}

function drawFossegren(ctx,W,H,t){
  const by=H*0.45, bx=W*0.5;
  // Waterfall bg
  for(let i=0;i<6;i++){
    const wx=W*0.15+i*(W*0.12), wy=0;
    const wh=H*0.7+Math.sin(t*0.5+i)*H*0.05;
    const wg=ctx.createLinearGradient(wx,wy,wx,wy+wh);
    wg.addColorStop(0,'rgba(100,180,255,0.08)'); wg.addColorStop(1,'rgba(100,200,255,0.03)');
    ctx.fillStyle=wg; ctx.fillRect(wx,wy,3,wh);
  }
  // Figure (crouching)
  ctx.beginPath(); ctx.ellipse(bx,by+26,9,20,0,0,Math.PI*2);
  ctx.fillStyle='rgba(60,40,20,0.8)'; ctx.fill();
  ctx.beginPath(); ctx.ellipse(bx,by,10,12,0,0,Math.PI*2);
  ctx.fillStyle='rgba(70,50,30,0.8)'; ctx.fill();
  // Fiddle strings (6) in pride colors
  const prideColours=['rgb(228,3,3)','rgb(255,140,0)','rgb(255,237,0)','rgb(0,128,38)','rgb(0,77,255)','rgb(117,7,135)'];
  prideColours.forEach((col,i)=>{
    const sx=bx-18, ex=bx+22;
    const sy=by+5+i*5, ey=by+3+i*5;
    const vib=Math.sin(t*(8+i*1.2)+i)*3*(1+Math.sin(t*0.3)*0.5);
    ctx.beginPath(); ctx.moveTo(sx,sy);
    ctx.bezierCurveTo(sx+12,sy+vib,ex-12,ey+vib,ex,ey);
    ctx.strokeStyle=col; ctx.lineWidth=1; ctx.globalAlpha=0.75; ctx.stroke();
    ctx.globalAlpha=1;
  });
  // Bow
  const bangle=t*0.3;
  ctx.beginPath(); ctx.moveTo(bx+18,by+8); ctx.lineTo(bx+24+Math.cos(bangle)*12,by+20+Math.sin(bangle)*8);
  ctx.strokeStyle='rgba(200,160,80,0.7)'; ctx.lineWidth=1.5; ctx.stroke();
  ctx.font='10px Cinzel,serif'; ctx.fillStyle='rgba(255,255,255,0.25)';
  ctx.textAlign='center'; ctx.fillText('FOSSEGRIMEN — E. Grieg / Kittelsen 1904', W/2, H-10);
}

function drawDraugen(ctx,W,H,t){
  const wy=H*0.60;
  // Sea
  for(let i=0;i<5;i++){
    ctx.beginPath(); ctx.moveTo(0,wy+i*12);
    for(let x=0;x<=W;x+=8) ctx.lineTo(x,wy+i*12+Math.sin(x*0.02+t*(0.6+i*0.15))*5+Math.sin(x*0.05+t*0.8)*2);
    ctx.strokeStyle=`rgba(0,80,80,${0.15-i*0.02})`; ctx.lineWidth=2; ctx.stroke();
  }
  ctx.fillStyle='rgba(0,30,40,0.5)'; ctx.fillRect(0,wy,W,H-wy);
  // Half-rotted boat hull
  const hullX=W*0.35, hullY=wy-4;
  ctx.beginPath();
  ctx.moveTo(hullX-40,hullY); ctx.lineTo(hullX+40,hullY);
  ctx.lineTo(hullX+30,hullY+20); ctx.lineTo(hullX-30,hullY+20); ctx.closePath();
  ctx.fillStyle='rgba(30,18,10,0.85)'; ctx.fill();
  ctx.strokeStyle='rgba(60,40,20,0.4)'; ctx.lineWidth=1.5; ctx.stroke();
  // Seaweed
  [-25,-10,10,25].forEach((ox,i)=>{
    for(let j=0;j<3;j++){
      ctx.beginPath();
      const sx=hullX+ox+j*3, sy=wy;
      ctx.moveTo(sx,sy);
      for(let k=1;k<5;k++) ctx.lineTo(sx+Math.sin(t*0.5+k*0.8+i)*5,sy+k*7);
      ctx.strokeStyle=`rgba(0,80,40,${0.5-j*0.1})`; ctx.lineWidth=1.5; ctx.stroke();
    }
  });
  // Rising figure
  const dx=hullX, dy=wy-20+Math.sin(t*0.4)*4;
  ctx.beginPath(); ctx.ellipse(dx,dy-10,9,13,0,0,Math.PI*2);
  ctx.fillStyle='rgba(20,30,30,0.8)'; ctx.fill();
  // Cold green eyes
  [-1,1].forEach(side=>{
    const ex=dx+side*9, ey=dy-13+Math.sin(t*0.3)*1;
    const g=ctx.createRadialGradient(ex,ey,0,ex,ey,8);
    g.addColorStop(0,'rgba(0,220,160,0.9)'); g.addColorStop(1,'transparent');
    ctx.fillStyle=g; ctx.fillRect(ex-8,ey-8,16,16);
    ctx.beginPath(); ctx.ellipse(ex,ey,3.5,2.5,0,0,Math.PI*2);
    ctx.fillStyle='rgba(0,200,140,0.9)'; ctx.fill();
    // Reflection in water below
    ctx.beginPath(); ctx.ellipse(ex,wy+8+side*2,1.5,4+Math.sin(t)*2,0,0,Math.PI*2);
    ctx.fillStyle='rgba(0,200,140,0.15)'; ctx.fill();
  });
  ctx.font='10px Cinzel,serif'; ctx.fillStyle='rgba(255,255,255,0.25)';
  ctx.textAlign='center'; ctx.fillText('DRAUGEN — Th. Kittelsen 1887 / Byfjorden', W/2, H-10);
}

function drawBergtroll(ctx,W,H,t){
  const bx=W*0.5, by=H*0.42;
  // Rock silhouette (hunched)
  ctx.beginPath();
  ctx.moveTo(bx-50,H*0.85);
  ctx.bezierCurveTo(bx-55,H*0.5,bx-38,by+10,bx-20,by);
  ctx.bezierCurveTo(bx-5,by-5,bx+5,by-12,bx+15,by);
  ctx.bezierCurveTo(bx+30,by+5,bx+50,by+25,bx+55,H*0.85); ctx.closePath();
  ctx.fillStyle='rgba(30,25,20,0.88)'; ctx.fill();
  ctx.strokeStyle='rgba(60,50,40,0.5)'; ctx.lineWidth=2; ctx.stroke();
  // Pride cracks (glowing)
  const prideLines = [
    {x1:bx-20,y1:by+20,x2:bx-10,y2:by+45,col:'rgb(228,3,3)'},
    {x1:bx-8, y1:by+15,x2:bx+2, y2:by+40,col:'rgb(255,140,0)'},
    {x1:bx+4, y1:by+10,x2:bx+12,y2:by+35,col:'rgb(0,128,38)'},
    {x1:bx+15,y1:by+20,x2:bx+25,y2:by+50,col:'rgb(0,77,255)'},
    {x1:bx-30,y1:by+40,x2:bx-18,y2:by+65,col:'rgb(117,7,135)'},
  ];
  prideLines.forEach((l,i)=>{
    const glow=0.5+0.5*Math.sin(t*1.5+i*0.7);
    ctx.shadowBlur=10+glow*8; ctx.shadowColor=l.col;
    ctx.beginPath(); ctx.moveTo(l.x1,l.y1); ctx.lineTo(l.x2,l.y2);
    ctx.strokeStyle=l.col.replace('rgb','rgba').replace(')',`,${0.6+glow*0.35})`);
    ctx.lineWidth=1.5; ctx.stroke();
  });
  ctx.shadowBlur=0;
  // Eyes deep in shadow
  [-1,1].forEach(side=>{
    ctx.beginPath(); ctx.ellipse(bx+side*12,by+5,3,2,0,0,Math.PI*2);
    ctx.fillStyle=`rgba(255,180,60,${0.3+Math.sin(t*0.8)*0.2})`; ctx.fill();
  });
  // Moss on top
  ctx.beginPath();
  for(let i=0;i<16;i++) ctx.arc(bx-25+i*4, by+2+Math.sin(i*0.8)*4, 3, 0, Math.PI*2);
  ctx.fillStyle='rgba(0,60,20,0.5)'; ctx.fill();
  ctx.font='10px Cinzel,serif'; ctx.fillStyle='rgba(255,255,255,0.25)';
  ctx.textAlign='center'; ctx.fillText('BERGTROLLET — Th. Kittelsen 1892 / Bergen', W/2, H-10);
}

function branchDraw(ctx,x,y,len,w,depth,sway){
  if(depth===0||len<1.5) return;
  const ex=x+Math.cos(-Math.PI/2+sway)*len, ey=y+Math.sin(-Math.PI/2+sway)*len;
  ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(ex,ey);
  ctx.strokeStyle='rgba(4,8,12,0.9)'; ctx.lineWidth=w; ctx.stroke();
  branchDraw(ctx,ex,ey,len*0.72,w*0.65,depth-1,-sway*0.5+0.5);
  branchDraw(ctx,ex,ey,len*0.68,w*0.62,depth-1,-sway*0.5-0.45);
}

