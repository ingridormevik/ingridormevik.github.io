let hapticTimeout = null;
let fxAudioCtx = null;
function getFxCtx() {
  if (!fxAudioCtx) {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (Ctx) fxAudioCtx = new Ctx();
  }
  return fxAudioCtx;
}
function ensureFxCtx() {
  const ctx = getFxCtx();
  if (ctx && ctx.state === 'suspended') ctx.resume().catch(()=>{});
}
window.addEventListener('pointerdown', ensureFxCtx, { passive:true });
window.addEventListener('touchstart', ensureFxCtx, { passive:true });

function showLegendary(key) {
  const data = LEGENDARY_DATA[key];
  if (!data) return;
  const box = document.getElementById('legendaryNotification');
  if (!box) return;
  box.style.setProperty('--ln-color', data.color);
  box.querySelector('.ln-icon').textContent = data.icon;
  box.querySelector('.ln-title').textContent = data.title;
  box.querySelector('.ln-sub').textContent = data.sub;
  box.classList.remove('show');
  void box.offsetWidth;
  box.classList.add('show');
  setTimeout(() => box.classList.remove('show'), 2200);
}

function showHaptic(text) {
  const el = document.getElementById('hapticIndicator');
  if (!el) return;
  el.textContent = text;
  el.classList.add('show');
  clearTimeout(hapticTimeout);
  hapticTimeout = setTimeout(() => el.classList.remove('show'), 1400);
}

function ritualFeedback(host, count=1) {
  const pattern = [
    [40],[24,18,40],[30,18,50,18,68],[34,18,56,18,78,18,96],[50,30,70,30,100,30,140]
  ][Math.min(Math.max(count-1,0),4)];
  let vib = false;
  if ('vibrate' in navigator) {
    try { navigator.vibrate(pattern); vib = true; } catch(e){}
  }
  if (!vib) {
    try {
      const ctx = getFxCtx();
      if (ctx) {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime([48,60,72,86,108][Math.min(Math.max(count-1,0),4)], now);
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.14, now + 0.03);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.26);
        osc.connect(gain); gain.connect(ctx.destination); osc.start(now); osc.stop(now+0.28);
      }
    } catch(e){}
    if (host) {
      host.animate([
        { transform:'translate3d(0,0,0)' },
        { transform:'translate3d(-2px,1px,0)' },
        { transform:'translate3d(2px,-1px,0)' },
        { transform:'translate3d(0,0,0)' }
      ], { duration:260, easing:'ease-out' });
    }
  }
  showHaptic(vib ? 'RITUELL HAPTIKK · VIBRASJON' : 'RITUELL HAPTIKK · LYD + RISTING');
}

