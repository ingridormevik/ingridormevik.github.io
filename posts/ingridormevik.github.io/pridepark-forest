<script>
// ============================================================
// STATE
// ============================================================
const state = {
  found: { nokken:false, huldra:false, fossegren:false, draugen:false, bergtroll:false },
  current: 'start',
  audioOn: false,
  audioCtx: null,
  creatureTab: {},
  mapNight: true, // start in night mode
};

function markFound(c) {
  state.found[c] = true;
  const dot = document.getElementById('pd-' + c);
  if (dot) dot.classList.add('found');
  haptic([40, 30, 40]);
  if (Object.values(state.found).every(v => v)) {
    setTimeout(() => go('alle_funnet'), 800);
  }
}

function foundCount() {
  return Object.values(state.found).filter(Boolean).length;
}

// ============================================================
// NAVIGATION
// ============================================================
function go(passage, opts = {}) {
  state.current = passage;
  updateProgress();
  const si = document.getElementById('scroll-inner');
  si.style.opacity = 0;
  setTimeout(() => {
    si.innerHTML = '';
    const content = PASSAGES[passage];
    if (typeof content === 'function') {
      si.innerHTML = content(opts);
    } else {
      si.innerHTML = content;
    }
    si.classList.remove('fade-in');
    void si.offsetWidth;
    si.classList.add('fade-in');
    si.style.opacity = 1;
    document.getElementById('scroll').scrollTop = 0;
    if (passage === 'map') initMap();
    bindChoices();
    if (opts.tab) initTabs(opts.creature, opts.tab);
    else if (passage.includes('_')) initTabs(passage.split('_')[0], 'folklore');
    enhancePassageVisuals(passage, opts);
    document.dispatchEvent(new CustomEvent('passage-change', { detail: { passage, opts } }));
  }, 200);
}

function bindChoices() {
  document.querySelectorAll('[data-go]').forEach(el => {
    el.addEventListener('click', () => {
      const tgt = el.dataset.go;
      const opts = el.dataset.opts ? JSON.parse(el.dataset.opts) : {};
      if (el.dataset.found) markFound(el.dataset.found);
      rippleAt(el);
      haptic([20]);
      go(tgt, opts);
    });
  });
}

function updateProgress() {
  const dots = document.querySelectorAll('.prog-dot');
  dots.forEach(d => d.classList.remove('active'));
  const creatures = ['nokken','huldra','fossegren','draugen','bergtroll'];
  creatures.forEach(c => {
    const d = document.getElementById('pd-'+c);
    if (d && state.found[c]) d.classList.add('found');
  });
}

// ============================================================
// HAPTICS
// ============================================================
function haptic(pattern) {
  if (navigator.vibrate) navigator.vibrate(pattern);
}

function rippleAt(el) {
  const r = el.getBoundingClientRect();
  const cx = r.left + r.width/2, cy = r.top + r.height/2;
  const rip = document.createElement('div');
  rip.className = 'ripple';
  rip.style.left = cx + 'px'; rip.style.top = cy + 'px';
  document.body.appendChild(rip);
  setTimeout(() => rip.remove(), 700);
}

// ============================================================
// AUDIO
// ============================================================
let oscNodes = [];
function toggleAudio() {
  state.audioOn = !state.audioOn;
  const ind = document.getElementById('audio-indicator');
  const lbl = document.getElementById('audio-label');
  if (state.audioOn) {
    startAmbient();
    ind.classList.remove('muted');
    lbl.textContent = 'LYD';
  } else {
    stopAmbient();
    ind.classList.add('muted');
    lbl.textContent = 'STILLE';
  }
}

function startAmbient() {
  if (!state.audioCtx) state.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  const ctx = state.audioCtx;
  if (ctx.state === 'suspended') ctx.resume();
  stopAmbient();
  // Wind-like noise
  const buf = ctx.createBuffer(1, ctx.sampleRate * 4, ctx.sampleRate);
  const data = buf.getChannelData(0);
  for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * 0.15;
  const src = ctx.createBufferSource(); src.buffer = buf; src.loop = true;
  const lp = ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value = 600;
  const gain = ctx.createGain(); gain.gain.value = 0.08;
  src.connect(lp); lp.connect(gain); gain.connect(ctx.destination);
  src.start();
  // Drone
  [110, 165, 220].forEach((freq, i) => {
    const osc = ctx.createOscillator();
    osc.type = 'sine'; osc.frequency.value = freq;
    const g = ctx.createGain(); g.gain.value = 0.015 - i*0.003;
    osc.connect(g); g.connect(ctx.destination); osc.start();
    oscNodes.push({osc, g, src});
  });
}

function stopAmbient() {
  oscNodes.forEach(n => { try { n.osc && n.osc.stop(); n.src && n.src.stop(); } catch(e){} });
  oscNodes = [];
}

function playCreatureSound(creature) {
  if (!state.audioOn || !state.audioCtx) return;
  const ctx = state.audioCtx;
  const profiles = {
    nokken:    { freq: 220, type: 'sine',     dur: 1.2, mod: 3 },
    huldra:    { freq: 330, type: 'triangle', dur: 1.0, mod: 5 },
    fossegren: { freq: 440, type: 'sawtooth', dur: 0.8, mod: 8 },
    draugen:   { freq: 110, type: 'sine',     dur: 1.8, mod: 1.5 },
    bergtroll: { freq: 80,  type: 'square',   dur: 0.5, mod: 0.5 },
  };
  const p = profiles[creature]; if (!p) return;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = p.type; osc.frequency.value = p.freq;
  gain.gain.setValueAtTime(0, ctx.currentTime);
  gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 0.1);
  gain.gain.linearRampToValueAtTime(0, ctx.currentTime + p.dur);
  osc.connect(gain); gain.connect(ctx.destination);
  osc.start(); osc.stop(ctx.currentTime + p.dur + 0.1);
}

// ============================================================
// MAP ENGINE
// ============================================================
let mapAnimT = 0, mapHov = null, mapParticles = [];

// Accurate Nygårdsparken hotspots based on official Pride Park 2026 map
// Coordinates are fractions of canvas W/H
const MAP_ZONES = [
{
 id:'cdn',
 label:'CENTER FOR DIGITAL NARRATIVE',
