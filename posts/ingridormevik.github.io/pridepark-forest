function initMap() {
  // Preload real map photos
  if (!initMap._dayImg) {
    initMap._dayImg = new Image();
    initMap._dayImg.src = 'data:image/png;base64,';
  }
  if (!initMap._nightImg) {
    initMap._nightImg = new Image();
    initMap._nightImg.src = 'data:image/png;base64,';
  }
  const wrap = document.getElementById('map-canvas-wrap');
  if (!wrap) return;
  const canvas = document.getElementById('map-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const tooltip = document.getElementById('map-tooltip');
  const ttN = document.getElementById('map-tt-name');
  const ttD = document.getElementById('map-tt-desc');

  function resize() {
    const W = wrap.clientWidth;
    // On mobile use more vertical space (up to 80vh), on desktop keep 0.69 ratio
    const maxH = Math.round(window.innerHeight * 0.78);
    const ratioH = Math.round(W * 0.69);
    const H = Math.min(Math.max(ratioH, window.innerWidth < 500 ? Math.round(window.innerHeight * 0.62) : ratioH), maxH);
    canvas.width = W * (devicePixelRatio||1);
    canvas.height = H * (devicePixelRatio||1);
    canvas.style.width = W+'px'; canvas.style.height = H+'px';
  }
  resize();

  // ── Nygårdsparken boundary (red line on official map, CW from top-Høyden entrance)
  // Based on official Pride Park 2026 map image proportions
  const PKB = [
    [0.30,0.01],[0.34,0.01],[0.42,0.04],[0.50,0.07],[0.58,0.11],
    [0.64,0.16],[0.70,0.22],[0.75,0.30],[0.78,0.38],[0.80,0.46],
    [0.80,0.54],[0.78,0.63],[0.74,0.71],[0.68,0.78],[0.60,0.84],
    [0.50,0.88],[0.40,0.90],[0.30,0.90],[0.20,0.87],[0.12,0.82],
    [0.06,0.74],[0.04,0.65],[0.04,0.55],[0.06,0.46],[0.08,0.38],
    [0.10,0.29],[0.14,0.21],[0.20,0.14],[0.26,0.07],
  ];
  // Langedammen lake shape (center-left of park)
  const LKB = [
    [0.14,0.53],[0.20,0.50],[0.28,0.49],[0.36,0.51],[0.40,0.56],
    [0.39,0.63],[0.33,0.68],[0.24,0.70],[0.15,0.68],[0.11,0.62],
    [0.11,0.56],
  ];
  // Rødafjellet / Høyden elevated area (upper-left rust-red zone)
  const HYD = [
    [0.24,0.03],[0.38,0.03],[0.50,0.08],[0.52,0.15],[0.50,0.22],
    [0.42,0.26],[0.32,0.25],[0.24,0.20],[0.20,0.13],
  ];

  function draw() {
    const dpr = devicePixelRatio||1;
    const W = canvas.width/dpr, H = canvas.height/dpr;
    const parkPath = (pts) => { ctx.beginPath(); pts.forEach(([fx,fy],i)=> i===0?ctx.moveTo(fx*W,fy*H):ctx.lineTo(fx*W,fy*H)); ctx.closePath(); };

    const N = state.mapNight; // night / day toggle

    // ── Background: real map photo (day or night)
    ctx.fillStyle = N ? 'rgba(8,10,20,1)' : 'rgba(200,195,180,1)';
    ctx.fillRect(0,0,W,H);
    const mapImg = N ? initMap._nightImg : initMap._dayImg;
    if (mapImg && mapImg.complete && mapImg.naturalWidth > 0) {
      // Draw image to fill canvas, preserving aspect ratio (cover)
      const iw = mapImg.naturalWidth, ih = mapImg.naturalHeight;
      const scale = Math.max(W/iw, H/ih);
      const dw = iw*scale, dh = ih*scale;
      const dx = (W-dw)/2, dy = (H-dh)/2;
      ctx.globalAlpha = 1;
      ctx.drawImage(mapImg, dx, dy, dw, dh);
    }
    // Animated ripple on lake (night)
    if(N){
      ctx.beginPath(); ctx.arc(W*0.25,H*0.60+Math.sin(mapAnimT*0.7)*2,W*0.04,0,Math.PI*2);
      ctx.strokeStyle='rgba(0,200,150,0.10)'; ctx.lineWidth=1.5; ctx.stroke();
    }

    // ── Paths / Turvei
    // Hovedturvei west curve
    ctx.beginPath();
    ctx.moveTo(W*0.08,H*0.44); ctx.bezierCurveTo(W*0.16,H*0.44,W*0.24,H*0.46,W*0.36,H*0.46);
    ctx.bezierCurveTo(W*0.44,H*0.46,W*0.48,H*0.45,W*0.52,H*0.46);
    ctx.strokeStyle=N?'rgba(255,200,100,0.10)':'rgba(200,170,80,0.35)';
    ctx.lineWidth=5; ctx.setLineDash([3,5]); ctx.stroke(); ctx.setLineDash([]);
    // Hovedturvei south arc
    ctx.beginPath();
    ctx.moveTo(W*0.44,H*0.46); ctx.bezierCurveTo(W*0.52,H*0.52,W*0.58,H*0.58,W*0.56,H*0.66);
    ctx.strokeStyle=N?'rgba(255,200,100,0.08)':'rgba(200,170,80,0.28)';
    ctx.lineWidth=4; ctx.setLineDash([3,6]); ctx.stroke(); ctx.setLineDash([]);

    // ── Fontplassen circle (center landmark)
    ctx.beginPath(); ctx.arc(W*0.45,H*0.44,W*0.038,0,Math.PI*2);
    ctx.fillStyle=N?'rgba(255,180,80,0.07)':'rgba(210,185,120,0.45)'; ctx.fill();
    ctx.strokeStyle=N?'rgba(255,180,80,0.22)':'rgba(170,140,60,0.55)'; ctx.lineWidth=1; ctx.stroke();
    ctx.font=`${Math.max(6,W*0.012)}px 'Courier Prime',monospace`;
    ctx.fillStyle=N?'rgba(255,180,80,0.40)':'rgba(100,80,20,0.7)';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('FONTPLASSEN',W*0.45,H*0.44);

    // ── Regnbuedagene stage banner area (painted stage pipe/rainbow, upper center)
    ctx.beginPath();
    ctx.moveTo(W*0.47,H*0.25); ctx.lineTo(W*0.55,H*0.25); ctx.lineTo(W*0.55,H*0.31); ctx.lineTo(W*0.47,H*0.31); ctx.closePath();
    const rbc=['228,3,3','255,140,0','255,237,0','0,128,38','0,77,255','117,7,135'];
    const bw=(W*0.08)/6;
    rbc.forEach((c,i)=>{
      ctx.fillStyle=`rgba(${c},${N?0.5:0.35})`; ctx.fillRect(W*0.47+i*bw,H*0.25,bw,H*0.06);
    });
    ctx.font=`${Math.max(5,W*0.011)}px 'Courier Prime',monospace`;
    ctx.fillStyle=N?'rgba(255,255,255,0.35)':'rgba(0,0,0,0.5)';
    ctx.textAlign='center'; ctx.fillText('REGNBUEDAGENE',W*0.51,H*0.34);

    // ── Scattered trees (park vegetation)
    const treeSpots = N
      ? [[0.56,0.14],[0.65,0.20],[0.72,0.35],[0.68,0.54],[0.62,0.66],[0.48,0.72],[0.36,0.74],[0.20,0.72],[0.10,0.64]]
      : [[0.56,0.14],[0.65,0.20],[0.72,0.35],[0.68,0.54],[0.62,0.66],[0.48,0.72],[0.36,0.74],[0.20,0.72],[0.10,0.64]];
    treeSpots.forEach(([fx,fy])=>{
      if(N){
        const sw=Math.sin(mapAnimT*0.5+fx*9)*0.03;
        drawMapTree(ctx,fx*W,fy*H,H*0.065,sw,true);
      } else {
        ctx.beginPath(); ctx.arc(fx*W,fy*H,W*0.018,0,Math.PI*2);
        ctx.fillStyle='rgba(55,95,35,0.55)'; ctx.fill();
        ctx.beginPath(); ctx.arc(fx*W,fy*H,W*0.010,0,Math.PI*2);
        ctx.fillStyle='rgba(70,115,45,0.45)'; ctx.fill();
      }
    });

    // ── Entrances / exits from official map
    const entries = [
      {fx:0.31,fy:0.00,label:'↑ HØYDEN',      col:'rgba(100,220,70,0.9)'},
      {fx:0.03,fy:0.44,label:'← MARINEN',      col:'rgba(100,220,70,0.9)'},
      {fx:0.81,fy:0.61,label:'FLORIDA →',      col:'rgba(100,220,70,0.9)'},
      {fx:0.54,fy:0.18,label:'EXIT →',          col:N?'rgba(80,200,80,0.7)':'rgba(0,140,0,0.8)'},
      {fx:0.62,fy:0.31,label:'EXIT →',          col:N?'rgba(80,200,80,0.7)':'rgba(0,140,0,0.8)'},
    ];
    entries.forEach(e=>{
      ctx.font=`bold ${Math.max(7,W*0.017)}px 'Cinzel',serif`;
      ctx.fillStyle=e.col; ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText(e.label, e.fx*W, e.fy*H);
    });

    // ── Balkonene / Sangertrapppen label (upper right, between exits)
    ctx.font=`${Math.max(6,W*0.012)}px 'Courier Prime',monospace`;
    ctx.fillStyle=N?'rgba(255,255,255,0.25)':'rgba(0,0,0,0.4)';
    ctx.textAlign='center';
    ctx.fillText('BALKONER',W*0.64,H*0.22);
    ctx.fillText('SANGERTRAPPPEN',W*0.62,H*0.29);
    ctx.fillText('TEKNISK BYGG',W*0.70,H*0.47);

    // ── Marinehagen 18+ badge (lower-right corner, outside park)
    const mbx=W*0.63, mby=H*0.88, mbw=W*0.24, mbh=H*0.10;
    rRect(ctx,mbx,mby,mbw,mbh,4);
    ctx.fillStyle=N?'rgba(255,180,80,0.18)':'rgba(200,140,40,0.25)'; ctx.fill();
    rRect(ctx,mbx,mby,mbw,mbh,4);
    ctx.strokeStyle=N?'rgba(255,180,80,0.55)':'rgba(180,120,20,0.6)'; ctx.lineWidth=1.5; ctx.stroke();
    ctx.font=`bold ${Math.max(7,W*0.016)}px 'Cinzel',serif`;
    ctx.fillStyle=N?'rgba(255,200,100,0.85)':'rgba(120,80,0,0.85)';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('MARINEHAGEN 18+',mbx+mbw/2,mby+mbh*0.38);
    ctx.font=`${Math.max(6,W*0.011)}px 'Courier Prime',monospace`;
    ctx.fillStyle=N?'rgba(255,200,100,0.55)':'rgba(100,70,0,0.6)';
    ctx.fillText('Regnbuenatt 6. juni kl 22',mbx+mbw/2,mby+mbh*0.72);

    // ── ZONES — AAA immersive hotspots
    const CREATURE_IDS = new Set(['bergtroll','huldra','fossegren','nokken','draugen']);
    MAP_ZONES.forEach(z => {
      const x=z.fx*W, y=z.fy*H, w=z.fw*W, h=z.fh*H;
      const cx2=x+w/2, cy2=y+h/2;
      const isHov = mapHov && mapHov.id === z.id;
      const found = state.found[z.id];
      const isCreature = CREATURE_IDS.has(z.id);
      const pulse  = 0.5+0.5*Math.sin(mapAnimT*1.6+z.fx*9);
      const pulse2 = 0.5+0.5*Math.sin(mapAnimT*2.2+z.fy*7+1.2);
      const hovScale = isHov ? 1.06 : 1.0;

      ctx.save();
      // Scale from center on hover
      ctx.translate(cx2, cy2);
      ctx.scale(hovScale, hovScale);
      ctx.translate(-cx2, -cy2);

      // ── 1. Far outer glow halo (creatures only or hovered)
      if(isCreature || isHov) {
        const haloR = Math.max(w,h)*0.72 + pulse*6;
        const haloA = (isHov ? 0.22 : 0.10) + pulse*0.06;
        const haloG = ctx.createRadialGradient(cx2,cy2,0,cx2,cy2,haloR);
        haloG.addColorStop(0, z.col+haloA+')');
        haloG.addColorStop(0.5, z.col+(haloA*0.4)+')');
        haloG.addColorStop(1,'rgba(0,0,0,0)');
        ctx.fillStyle = haloG;
        ctx.beginPath(); ctx.ellipse(cx2,cy2,haloR,haloR*0.75,0,0,Math.PI*2); ctx.fill();
      }

      // ── 2. Outer pulse ring (animated expanding circle)
      if(isCreature || isHov) {
        const ringPhase = (mapAnimT*0.8 + z.fx*5) % 1;
        const ringR = (Math.max(w,h)*0.55) * (0.6 + ringPhase*0.8);
        const ringA = (1-ringPhase) * (isHov ? 0.7 : 0.35);
        ctx.beginPath(); ctx.arc(cx2,cy2,ringR,0,Math.PI*2);
        ctx.strokeStyle = z.col+ringA+')';
        ctx.lineWidth = isHov ? 2.5 : 1.2;
        ctx.stroke();
        // second ring offset
        const ring2Phase = ((mapAnimT*0.8 + z.fx*5 + 0.5) % 1);
        const ring2R = (Math.max(w,h)*0.55) * (0.6 + ring2Phase*0.8);
        const ring2A = (1-ring2Phase) * (isHov ? 0.45 : 0.18);
        ctx.beginPath(); ctx.arc(cx2,cy2,ring2R,0,Math.PI*2);
        ctx.strokeStyle = z.col+ring2A+')';
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      // ── 3. Glass fill — rich layered backdrop
      ctx.save();
      ctx.shadowBlur = isHov ? 28 : (isCreature ? 18 : 10);
      ctx.shadowColor = z.col+'0.9)';
      rRect(ctx,x,y,w,h,7);
      ctx.restore();

      // Backdrop blur simulation — dark semi-transparent base
      rRect(ctx,x,y,w,h,7);
      const bgA = found ? 0.78 : (isHov ? 0.72 : 0.58);
      ctx.fillStyle = N ? `rgba(4,6,18,${bgA})` : `rgba(250,245,220,${bgA*0.82})`;
      ctx.fill();

      // Colour tint overlay with gradient
      rRect(ctx,x,y,w,h,7);
      const tintG = ctx.createLinearGradient(x,y,x,y+h);
      const tintA = found ? 0.55 : (isHov ? 0.52 : 0.30+pulse*0.14);
      tintG.addColorStop(0, z.col+(tintA)+')');
      tintG.addColorStop(1, z.col+(tintA*0.35)+')');
      ctx.fillStyle = tintG; ctx.fill();

      // Gloss sheen — top highlight
      rRect(ctx,x,y,w,h*0.45,7);
      ctx.fillStyle = `rgba(255,255,255,${isHov?0.14:0.06})`; ctx.fill();

      // ── 4. Border — multi-layer for depth
      // Outer glow border
      ctx.save();
      ctx.shadowBlur = isHov ? 20 : (isCreature ? 12 : 6);
      ctx.shadowColor = z.col+(isHov?'0.95)':'0.7)');
      rRect(ctx,x,y,w,h,7);
      ctx.strokeStyle = z.col+(isHov?'1.0)':found?'0.85)':'0.60)');
      ctx.lineWidth = isHov ? 2.5 : (isCreature ? 1.8 : 1.2);
      ctx.stroke();
      ctx.restore();
      // Inner fine border
      rRect(ctx,x+1,y+1,w-2,h-2,6);
      ctx.strokeStyle = `rgba(255,255,255,${isHov?0.25:0.08})`;
      ctx.lineWidth = 0.5; ctx.stroke();

      // ── 5. Shimmer sweep on hover
      if(isHov) {
        const shimX = x + ((mapAnimT*0.4)%1.4 - 0.2)*w*1.2;
        const shimG = ctx.createLinearGradient(shimX-w*0.15, y, shimX+w*0.15, y+h);
        shimG.addColorStop(0,'rgba(255,255,255,0)');
        shimG.addColorStop(0.5,'rgba(255,255,255,0.18)');
        shimG.addColorStop(1,'rgba(255,255,255,0)');
        ctx.save();
        rRect(ctx,x,y,w,h,7); ctx.clip();
        ctx.fillStyle=shimG; ctx.fillRect(x,y,w,h);
        ctx.restore();
      }

      // ── 6. Corner accent dots
      const dotR = Math.max(2, w*0.045);
      const dotA = isHov ? 0.9 : 0.45+pulse2*0.25;
      [[x+dotR+1,y+dotR+1],[x+w-dotR-1,y+dotR+1]].forEach(([dx,dy])=>{
        ctx.beginPath(); ctx.arc(dx,dy,dotR,0,Math.PI*2);
        ctx.fillStyle = z.col+dotA+')'; ctx.fill();
        if(isHov){ctx.strokeStyle='rgba(255,255,255,0.5)';ctx.lineWidth=0.5;ctx.stroke();}
      });

      // ── 7. Image / marker — creature portraits on map, geometric markers for facilities
      ctx.save();
      const imageKey = z.id === 'fossegren' ? 'fossegren' : z.id;
      const mapImg = MAP_CREATURE_IMAGES[imageKey];
      if (isCreature && mapImg && mapImg.complete) {
        const imgBox = Math.min(w, h) * (isHov ? 0.76 : 0.66);
        const ix = cx2 - imgBox / 2;
        const iy = cy2 - imgBox * 0.58;
        ctx.beginPath();
        ctx.arc(cx2, cy2 - h*0.05, imgBox*0.36, 0, Math.PI*2);
        ctx.closePath();
        ctx.save();
        ctx.clip();
        ctx.globalAlpha = isHov ? 1 : 0.96;
        ctx.drawImage(mapImg, ix, iy, imgBox, imgBox * (mapImg.height / mapImg.width));
        ctx.restore();
        ctx.beginPath();
        ctx.arc(cx2, cy2 - h*0.05, imgBox*0.36, 0, Math.PI*2);
        ctx.strokeStyle = z.col + (isHov ? '0.90)' : '0.65)');
        ctx.lineWidth = isHov ? 2.2 : 1.4;
        ctx.shadowBlur = isHov ? 18 : 10;
        ctx.shadowColor = z.col+'0.85)';
        ctx.stroke();
      } else {
        const markerR = Math.min(w,h)*(isHov?0.20:0.17);
        ctx.translate(cx2, cy2 - h*0.05);
        ctx.rotate(Math.PI/4);
        ctx.fillStyle = z.col + (isHov ? '0.22)' : '0.15)');
        ctx.strokeStyle = z.col + (isHov ? '0.92)' : '0.60)');
        ctx.lineWidth = isHov ? 2 : 1.2;
        ctx.shadowBlur = isHov ? 16 : 8;
        ctx.shadowColor = z.col+'0.80)';
        ctx.fillRect(-markerR, -markerR, markerR*2, markerR*2);
        ctx.strokeRect(-markerR, -markerR, markerR*2, markerR*2);
        ctx.rotate(-Math.PI/4);
        ctx.beginPath();
        ctx.arc(0, 0, markerR*0.42, 0, Math.PI*2);
        ctx.fillStyle = z.col + (isHov ? '0.95)' : '0.75)');
        ctx.fill();
      }
      ctx.restore();

      // ── 8. Label — styled pill at bottom
      const lblSz = Math.max(7, Math.min(w*0.115, 10));
      ctx.font = `bold ${lblSz}px 'Courier Prime',monospace`;
      ctx.textAlign='center';
      const lblMetrics = ctx.measureText(z.label);
      const lblW = lblMetrics.width + 10, lblH = lblSz + 6;
      const lblX = cx2 - lblW/2, lblY = y+h-lblH-3;
      // Pill background
      rRect(ctx, lblX, lblY, lblW, lblH, lblH/2);
      ctx.fillStyle = N ? `rgba(0,0,12,${isHov?0.88:0.65})` : `rgba(10,5,0,${isHov?0.78:0.60})`;
      ctx.fill();
      rRect(ctx, lblX, lblY, lblW, lblH, lblH/2);
      ctx.strokeStyle = z.col+(isHov?'0.8)':'0.45)'); ctx.lineWidth=0.8; ctx.stroke();
      ctx.fillStyle = isHov ? '#fff' : (N?'rgba(255,255,255,0.90)':'rgba(255,255,255,0.88)');
      ctx.textBaseline='middle';
      ctx.shadowBlur=4; ctx.shadowColor=z.col+'0.7)';
      ctx.fillText(z.label, cx2, lblY+lblH/2);
      ctx.shadowBlur=0;

      // ── 9. Found checkmark badge
      if(found){
        const bsz=Math.max(10,w*0.18);
        ctx.save();
        ctx.beginPath(); ctx.arc(x+w-bsz*0.5-2, y+bsz*0.5+2, bsz*0.55, 0, Math.PI*2);
        ctx.fillStyle='rgba(0,200,110,0.92)'; ctx.fill();
        ctx.strokeStyle='rgba(255,255,255,0.7)'; ctx.lineWidth=1; ctx.stroke();
        const tx=x+w-bsz*0.5-2, ty=y+bsz*0.5+2;
        ctx.strokeStyle='#fff'; ctx.lineWidth=Math.max(1.4, bsz*0.12);
        ctx.lineCap='round'; ctx.lineJoin='round'; ctx.shadowBlur=0;
        ctx.beginPath();
        ctx.moveTo(tx-bsz*0.18, ty+bsz*0.02);
        ctx.lineTo(tx-bsz*0.02, ty+bsz*0.18);
        ctx.lineTo(tx+bsz*0.20, ty-bsz*0.14);
        ctx.stroke();
        ctx.restore();
      }

      // ── 10. Creature: pulsing scanline overlay
      if(isCreature) {
        ctx.save();
        rRect(ctx,x,y,w,h,7); ctx.clip();
        for(let sl=0;sl<3;sl++){
          const slY = y + ((mapAnimT*0.3 + sl/3 + z.fy) % 1) * h;
          ctx.fillStyle = `rgba(255,255,255,0.04)`;
          ctx.fillRect(x, slY, w, 1.5);
        }
        ctx.restore();
      }

      ctx.restore(); // undo hover scale
    });

    // ── Particles (with glow)
    mapParticles = mapParticles.filter(p => {
      p.y -= p.vy; p.x += p.vx; p.vy -= 0.04; p.life -= 0.022; if(p.life<=0)return false;
      const a = p.life*0.9;
      ctx.save();
      ctx.shadowBlur = 8+p.r*2; ctx.shadowColor=`rgba(${p.col},${a})`;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r*p.life,0,Math.PI*2);
      ctx.fillStyle=`rgba(${p.col},${a})`; ctx.fill();
      ctx.restore();
      return true;
    });

    // ── Day/Night toggle button (top-right corner of canvas)
    const btnX=W*0.72, btnY=4, btnW=W*0.26, btnH=H*0.075;
    rRect(ctx,btnX,btnY,btnW,btnH,5);
    ctx.fillStyle=N?'rgba(12,14,30,0.88)':'rgba(248,238,180,0.88)'; ctx.fill();
    rRect(ctx,btnX,btnY,btnW,btnH,5);
    ctx.strokeStyle=N?'rgba(255,180,80,0.45)':'rgba(170,130,30,0.55)'; ctx.lineWidth=1; ctx.stroke();
    ctx.font=`bold ${Math.max(8,btnH*0.45)}px 'Courier Prime',monospace`;
    ctx.fillStyle=N?'rgba(255,230,150,0.92)':'rgba(60,40,0,0.92)';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(N?'DAGMODUS':'NATTMODUS', btnX+btnW/2, btnY+btnH/2);
    // Store button rect for click detection
    canvas._dayNightBtn = {x:btnX,y:btnY,w:btnW,h:btnH};

    // ── Scale / credit
    ctx.font=`${Math.max(6,W*0.012)}px 'Courier Prime',monospace`;
    ctx.fillStyle=N?'rgba(255,255,255,0.16)':'rgba(0,0,0,0.30)';
    ctx.textAlign='left'; ctx.textBaseline='bottom';
    ctx.fillText('NYGÅRDSPARKEN / PRIDE PARK 2026  ·  bergenpride.no',7,H-4);

    ctx.restore();
  }

  function drawMapTree(ctx2,x,y,h,sway,night){
    branchMap(ctx2,x,y,-Math.PI/2,h,2,5,sway,night);
  }
  function branchMap(ctx2,x,y,angle,len,w,depth,sway,night){
    if(depth===0||len<1.5) return;
    const ex=x+Math.cos(angle+sway)*len, ey=y+Math.sin(angle+sway)*len;
    ctx2.beginPath(); ctx2.moveTo(x,y); ctx2.lineTo(ex,ey);
    ctx2.strokeStyle=night?'rgba(8,18,12,0.88)':'rgba(30,60,18,0.75)'; ctx2.lineWidth=w; ctx2.stroke();
    branchMap(ctx2,ex,ey,angle-0.55+sway*0.3,len*0.72,w*0.65,depth-1,sway*0.8,night);
    branchMap(ctx2,ex,ey,angle+0.48+sway*0.2,len*0.68,w*0.60,depth-1,sway*0.8,night);
  }
  function rRect(c,x,y,w,h,r){
    c.beginPath();c.moveTo(x+r,y);c.lineTo(x+w-r,y);c.arcTo(x+w,y,x+w,y+r,r);c.lineTo(x+w,y+h-r);c.arcTo(x+w,y+h,x+w-r,y+h,r);c.lineTo(x+r,y+h);c.arcTo(x,y+h,x,y+h-r,r);c.lineTo(x,y+r);c.arcTo(x,y,x+r,y,r);c.closePath();
  }

  function hitTest(mx,my, extraPad=0) {
    const rect = canvas.getBoundingClientRect();
    const dpr = devicePixelRatio||1;
    const W = canvas.width/dpr, H = canvas.height/dpr;
    const x=(mx-rect.left)*(W/rect.width), y=(my-rect.top)*(H/rect.height);
    return MAP_ZONES.find(z=>{
      const zx = z.fx*W, zy = z.fy*H, zw = z.fw*W, zh = z.fh*H;
      const pad = extraPad || 0;
      return x >= zx-pad && x <= zx+zw+pad && y >= zy-pad && y <= zy+zh+pad;
    }) || null;
  }

  function showTooltip(e, z) {
    const rect = canvas.getBoundingClientRect();
    tooltip.querySelector('.tt-n').textContent = z.label;
    const creatureInfo = CREATURE_STAGE && CREATURE_STAGE[z.id];
    tooltip.querySelector('.tt-d').textContent = creatureInfo ? `${creatureInfo.ident} · ${z.desc}` : z.desc;
    let lx = e.clientX - rect.left + 12;
    let ly = e.clientY - rect.top - 10;
    const W = rect.width;
    if(lx+200>W) lx = e.clientX-rect.left-212;
    tooltip.style.left=lx+'px'; tooltip.style.top=ly+'px';
    tooltip.classList.add('show');
  }

  canvas.addEventListener('mousemove', e => {
    const z = hitTest(e.clientX, e.clientY);
    mapHov = z;
    canvas.style.cursor = z ? 'pointer' : 'crosshair';
    if(z) showTooltip(e,z); else tooltip.classList.remove('show');
  });

  canvas.addEventListener('touchmove', e => {
    const t = e.touches[0];
    const z = hitTest(t.clientX, t.clientY, 18);
    mapHov = z;
    if(z) showTooltip(t,z); else tooltip.classList.remove('show');
  }, {passive:true});

  canvas.addEventListener('click', e => {
    if (Date.now() - mapLastTouchTime < 450) return;
    const rect=canvas.getBoundingClientRect();
    const dpr=devicePixelRatio||1;
    const W=canvas.width/dpr,H=canvas.height/dpr;
    const cx=(e.clientX-rect.left)*(W/rect.width), cy=(e.clientY-rect.top)*(H/rect.height);
    const btn=canvas._dayNightBtn;
    if(btn && cx>=btn.x && cx<=btn.x+btn.w && cy>=btn.y && cy<=btn.y+btn.h){
      state.mapNight = !state.mapNight;
      mapHov = null;
      tooltip.classList.remove('show');
      haptic([20,10,20]);
      draw();
      return;
    }
    const z = hitTest(e.clientX, e.clientY, 8);
    if(!z) return;
    const colsRaw=z?z.col.replace('rgba(','').replace(',','').split(',').slice(0,3).join(','):'255,180,80';
    const cols=['255,180,80','160,60,220','0,200,110','255,20,147','0,200,180','255,237,0'];
    // Ring burst — radial spray
    for(let i=0;i<36;i++){
      const angle=(i/36)*Math.PI*2;
      const spd=1.5+Math.random()*3.5;
      mapParticles.push({x:cx,y:cy,vx:Math.cos(angle)*spd,vy:Math.sin(angle)*spd-0.5,r:1.5+Math.random()*2.5,life:1,col:cols[i%cols.length]});
    }
    // Central sparkle burst
    for(let i=0;i<18;i++) mapParticles.push({x:cx,y:cy,vx:(Math.random()-0.5)*5,vy:(Math.random()-0.5)*5-1,r:2.5+Math.random()*3.5,life:1,col:cols[Math.floor(Math.random()*cols.length)]});
    haptic([30, 20, 30]);
    // Route map zones to passages
    const ROUTE = {
 cdn:'cdn',
      scene:'fossegren', scene2:'fossegren', bar:'regnbuenatt',
      marinehagen:'regnbuenatt', merch:'map', ladestasjon:'map',
      pridehouse:'pridehouse', parade:'parade',
    };
    const dest = ROUTE[z.id] || z.id;
    if(PASSAGES[dest]) go(dest);
  });

  canvas.addEventListener('touchend', e => {
    mapLastTouchTime = Date.now();
    const t = e.changedTouches[0];
    const rect=canvas.getBoundingClientRect();
    const dpr=devicePixelRatio||1;
    const W=canvas.width/dpr,H=canvas.height/dpr;
    const cx=(t.clientX-rect.left)*(W/rect.width), cy=(t.clientY-rect.top)*(H/rect.height);
    const btn=canvas._dayNightBtn;
    if(btn && cx>=btn.x && cx<=btn.x+btn.w && cy>=btn.y && cy<=btn.y+btn.h){
      state.mapNight = !state.mapNight;
      mapHov = null;
      tooltip.classList.remove('show');
      haptic([20,10,20]);
      draw();
      return;
    }
    const z = hitTest(t.clientX, t.clientY, 18);
    if(!z) return;
    haptic([30,20,30]);
    const ROUTE = {scene:'fossegren',scene2:'fossegren',bar:'regnbuenatt',marinehagen:'regnbuenatt',merch:'map',ladestasjon:'map',pridehouse:'pridehouse',parade:'parade'};
    const dest = ROUTE[z.id] || z.id;
    if(PASSAGES[dest]) go(dest);
  });

  canvas.addEventListener('mouseleave',()=>{mapHov=null;tooltip.classList.remove('show');});

  let running = true;
  function loop(){if(!running)return;draw();requestAnimationFrame(loop);}
  loop();
  // Clean up when leaving map
  const orig = go;
  document.addEventListener('passage-change', ()=>{running=false;},{once:true});
}

