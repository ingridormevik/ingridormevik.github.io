  setState(false);

  btn.addEventListener('click', async (e) => {
    e.preventDefault();
    e.stopPropagation();
    try {
      if (audio.paused) {
        await audio.play();
        setState(true);
      } else {
        audio.pause();
        audio.currentTime = 0;
        setState(false);
      }
