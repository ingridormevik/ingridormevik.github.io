  { id:'draugen',   label:'DRAUGEN',     glyph:'', col:'rgba(0,200,180,',   fx:0.28, fy:0.70, fw:0.16, fh:0.14, desc:'Stiger fra Langedammen i mørket.' },
  // PARK FACILITIES — fra offisielt kart
  { id:'minipride', label:'MINI PRIDE',  glyph:'', col:'rgba(255,120,200,', fx:0.07, fy:0.34, fw:0.18, fh:0.22, desc:'Familieområdet. Røyk/rusfritt. Eira er her!' },
  { id:'scene',     label:'HOVED SCENE', glyph:'', col:'rgba(255,237,0,',   fx:0.30, fy:0.22, fw:0.14, fh:0.13, desc:'Konserter daglig 14-20. Åpningskonsert 29. mai.' },
  { id:'scene2',    label:'SCENE 2',     glyph:'', col:'rgba(255,140,0,',   fx:0.56, fy:0.56, fw:0.12, fh:0.12, desc:'Scene 2 med eget program. Sørsiden av parken.' },
  { id:'bar',       label:'BAR',         glyph:'', col:'rgba(100,180,255,', fx:0.55, fy:0.38, fw:0.14, fh:0.13, desc:'To barer ved Fontplassen. 18+ etter kl 21.' },
  { id:'merch',     label:'MERCH/INFO',  glyph:'',col:'rgba(255,80,80,',  fx:0.51, fy:0.50, fw:0.12, fh:0.11, desc:'Bergen Pride-butikk og informasjonspunkt.' },
  { id:'ladestasjon',label:'LADESTASJON',glyph:'', col:'rgba(255,237,0,',   fx:0.68, fy:0.68, fw:0.14, fh:0.13, desc:'Lad deg selv og telefonen. Røde Kors til stede.' },
  { id:'pridehouse',label:'PRIDE HOUSE', glyph:'', col:'rgba(0,200,110,',   fx:0.62, fy:0.23, fw:0.14, fh:0.13, desc:'Det Akademiske Kvarter. 30. mai-2. juni.' },
  { id:'marinehagen',label:'MARINEHAGEN',glyph:'', col:'rgba(255,180,80,',  fx:0.44, fy:0.75, fw:0.16, fh:0.13, desc:'18+ Regnbuenatt 6. juni kl 22:00. Billett kreves.' },
  { id:'parade',    label:'PARADE',      glyph:'', col:'rgba(0,200,110,',   fx:0.04, fy:0.76, fw:0.18, fh:0.11, desc:'Paraden starter kl 13:00 fra Festningskaien.' },
