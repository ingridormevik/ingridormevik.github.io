// Aurora shader overlay inspired by Bergen sky over Nygårdsparken
const auroraCanvas = document.getElementById('c-aurora-shader');
const auroraCtx = auroraCanvas ? auroraCanvas.getContext('2d') : null;
const fog2Canvas = document.getElementById('c-fog-2');
const fog2Ctx = fog2Canvas ? fog2Canvas.getContext('2d') : null;

function resizeAddedCanvases() {
  [auroraCanvas, fog2Canvas].forEach(c => {
    if (!c) return;
    c.width = window.innerWidth * (devicePixelRatio || 1);
    c.height = window.innerHeight * (devicePixelRatio || 1);
    c.style.width = window.innerWidth + 'px';
    c.style.height = window.innerHeight + 'px';
  });
}
resizeAddedCanvases();
window.addEventListener('resize', resizeAddedCanvases);

let auroraT = 0;
function auroraLoop() {
  if (auroraCtx && auroraCanvas) {
    const dpr = devicePixelRatio || 1;
    const W = auroraCanvas.width / dpr, H = auroraCanvas.height / dpr;
    auroraCtx.setTransform(dpr,0,0,dpr,0,0);
    auroraCtx.clearRect(0,0,W,H);
    auroraCtx.globalCompositeOperation = 'lighter';
    const bands = window.innerWidth < 700 ? 5 : 7;
    for (let i=0;i<bands;i++) {
      const baseY = H*(0.10+i*0.06);
      const amp = 22 + i*14;
      const grad = auroraCtx.createLinearGradient(0, baseY-80, W, baseY+120);
      grad.addColorStop(0, `rgba(0,200,180,${0.03+i*0.004})`);
      grad.addColorStop(.25, `rgba(0,200,110,${0.03+i*0.006})`);
      grad.addColorStop(.55, `rgba(255,180,80,${0.022+i*0.004})`);
      grad.addColorStop(.8, `rgba(160,60,220,${0.025+i*0.005})`);
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      auroraCtx.beginPath();
      auroraCtx.moveTo(0,H);
      for(let x=0;x<=W;x+=8){
        const y = baseY + Math.sin(x*0.006 + auroraT*(0.8+i*0.1))*amp
          + Math.sin(x*0.013 - auroraT*1.1)*(amp*0.45)
          + Math.cos(x*0.0025 + auroraT*0.8)*(amp*0.8);
        auroraCtx.lineTo(x,y);
      }
      auroraCtx.lineTo(W,H); auroraCtx.closePath();
      auroraCtx.fillStyle = grad; auroraCtx.fill();
    }
  }
  if (fog2Ctx && fog2Canvas) {
    const dpr = devicePixelRatio || 1;
    const W = fog2Canvas.width / dpr, H = fog2Canvas.height / dpr;
    fog2Ctx.setTransform(dpr,0,0,dpr,0,0);
    fog2Ctx.clearRect(0,0,W,H);
    for(let i=0;i<7;i++) {
      const x = ((auroraT*10)+(i*160))%(W+220)-110;
      const y = H*(0.15 + (i%4)*0.16) + Math.sin(auroraT*0.5+i)*18;
      const g = fog2Ctx.createRadialGradient(x,y,8,x,y,140+i*18);
      g.addColorStop(0,'rgba(255,255,255,0.07)');
      g.addColorStop(.45,'rgba(196,212,204,0.045)');
      g.addColorStop(1,'rgba(255,255,255,0)');
      fog2Ctx.fillStyle = g;
      fog2Ctx.beginPath();
      fog2Ctx.arc(x,y,140+i*18,0,Math.PI*2);
      fog2Ctx.fill();
    }
  }
  auroraT += 0.012;
  requestAnimationFrame(auroraLoop);
}
setTimeout(() => requestAnimationFrame(auroraLoop), 120);

