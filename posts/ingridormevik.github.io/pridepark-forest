},

  // CREATURES — placed at their narrative locations in the park
  { id:'bergtroll', label:'BERGTROLLET', glyph:'', col:'rgba(160,60,220,', fx:0.27, fy:0.05, fw:0.12, fh:0.14, desc:'Vokter Høyden-inngangen. Klikk for å møte ham.' },
